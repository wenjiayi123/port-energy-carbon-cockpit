APP_ENV=development
API_AUTH_MODE=disabled
# Production requires API_AUTH_MODE=api_key or oidc. Prefer oidc behind the enterprise ingress.
VIEWER_API_KEY=
OPERATOR_API_KEY=
ADMIN_API_KEY=
# OIDC mode verifies EdDSA JWTs, issuer, audience, time, MFA, mapped roles and signed tenant claims.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_PUBLIC_KEYS_JSON={}
OIDC_ROLE_MAP_JSON={"viewer":"viewer","operator":"operator","admin":"admin"}
OIDC_ROLE_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_ids
OIDC_REQUIRE_MFA=true
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_MAX_TOKEN_AGE_SECONDS=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8808
FRONTEND_PORT=5173
CARBON_PRICE_CNY_PER_TON=85
DEFAULT_SCENARIO=port_la_2025_public_benchmark
DEFAULT_GREEN_PREFERENCE=0.50
# Read-only port connection mode. Physical dispatch is not enabled by this repository.
PORT_OPERATION_MODE=offline_benchmark
LIVE_PORT_ID=
# JSON mapping of adapter IDs to independently rotated secrets (minimum 32 characters each).
PORT_SNAPSHOT_KEYS_JSON={}
INTEGRATION_STATE_PATH=backend/app/data/integration/state.json
# Runtime decisions, receipts and chained audit events; use a persistent volume in containers.
RUNTIME_STATE_PATH=backend/app/data/runtime/decisions.json
LIVE_MAX_CLOCK_SKEW_SECONDS=60
# JSON mappings of independent key IDs to raw Ed25519 public keys encoded as base64.
MV_VERIFIER_PUBLIC_KEYS_JSON={}
CARBON_REGISTRY_PUBLIC_KEYS_JSON={}
MANAGEMENT_SYSTEM_AUDITOR_PUBLIC_KEYS_JSON={}
OPERATIONS_SOURCE_PUBLIC_KEYS_JSON={}
ELECTRICAL_SOURCE_PUBLIC_KEYS_JSON={}
ALGORITHM_EVIDENCE_PUBLIC_KEYS_JSON={}
COMMERCIAL_SETTLEMENT_PUBLIC_KEYS_JSON={}
PORT_COLLABORATION_PUBLIC_KEYS_JSON={}
ENTERPRISE_SECURITY_PUBLIC_KEYS_JSON={}
SITE_CUTOVER_TRUSTED_SIGNERS_JSON={}
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RL_DEFAULT_DATASET=port_la_2025_monthly
RL_RUNS_DIR=backend/app/data/runs
XIAOYI_AI_PROJECT=/absolute/path/to/optional-xiaoyi-project
XIAOYI_AI_BASE_URL=http://127.0.0.1:8010
SAILING_SIM_PROJECT=/absolute/path/to/optional-godot-project
SAILING_SIM_GODOT=/absolute/path/to/Godot
