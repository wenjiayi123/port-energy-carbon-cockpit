APP_ENV=development
API_AUTH_MODE=disabled
# Production requires API_AUTH_MODE=api_key and random keys of at least 24 characters.
VIEWER_API_KEY=
OPERATOR_API_KEY=
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8808
FRONTEND_PORT=5173
CARBON_PRICE_CNY_PER_TON=85
DEFAULT_SCENARIO=port_la_2025_public_benchmark
DEFAULT_GREEN_PREFERENCE=0.50
# Read-only port connection mode. Physical dispatch is not enabled by this repository.
PORT_OPERATION_MODE=offline_benchmark
LIVE_PORT_ID=
# JSON mapping of adapter IDs to independently rotated secrets (minimum 32 characters each).
PORT_SNAPSHOT_KEYS_JSON={}
INTEGRATION_STATE_PATH=backend/app/data/integration/state.json
# Runtime decisions, receipts and chained audit events; use a persistent volume in containers.
RUNTIME_STATE_PATH=backend/app/data/runtime/decisions.json
LIVE_MAX_CLOCK_SKEW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RL_DEFAULT_DATASET=port_la_2025_monthly
RL_RUNS_DIR=backend/app/data/runs
XIAOYI_AI_PROJECT=/absolute/path/to/optional-xiaoyi-project
XIAOYI_AI_BASE_URL=http://127.0.0.1:8010
SAILING_SIM_PROJECT=/absolute/path/to/optional-godot-project
SAILING_SIM_GODOT=/absolute/path/to/Godot
